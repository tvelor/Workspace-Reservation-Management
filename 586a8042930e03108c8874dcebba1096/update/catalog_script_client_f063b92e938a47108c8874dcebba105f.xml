        <name>Prevent Submit With Invalid Date</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onSubmit() {
    // Read both values at moment of submission
    var start = g_form.getValue('start_date_time');
    var end = g_form.getValue('end_date_time');

    // Final gate — blocks submission if dates are invalid.
    // return false cancels the submit entirely;
    // without it the RITM gets created anyway
    if (start && end && end < start) {
        g_form.clearValue('end_date_time');
        g_form.showFieldMsg('end_date_time',
            'End date/time should not be before the Start date/time', 'error');
        return false;
    }

    return true;
}]]></script>
